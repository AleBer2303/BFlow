# Firebase Public Client Config (ADR 0027). REQUIRED: the source code ships no default project.
# API_KEY, PROJECT_ID and APP_ID are mandatory; without them the app cannot reach Firebase.
# Tests and `npm run web:demo` do not need them (they use an offline placeholder project).
# CI builds read the same names from the GitHub repository variables.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In iOS Client ID (Phase 3 — Mode B Native .ipa)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Local Encrypted Storage Pepper (ADR 0016 — AES-256 + HMAC-SHA256 derived with generated SecureStore token)
EXPO_PUBLIC_LOCAL_CIPHER_PEPPER=

# Owner seed account (ADR 0027). OPTIONAL: the email whose account receives the October 2026
# seed. Leave EMPTY and every account starts with an empty workspace.
EXPO_PUBLIC_OWNER_SEED_EMAIL=

# Local showcase mode (ADR 0010). Leave EMPTY in real builds.
# "1" boots signed in as the local demo user with the October 2026 seed, never talks to
# Firebase and accepts ?skin=ios|android|web and ?theme=dark|light in the URL.
# `npm run web:demo` sets it for you; you normally do not need to write it here.
EXPO_PUBLIC_BFLOW_DEMO=
