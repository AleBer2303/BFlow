# Firebase Public Client Config (ADR 0027). REQUIRED: the source code ships no default project.
# API_KEY, PROJECT_ID and APP_ID are mandatory; without them the app cannot reach Firebase.
# Tests and `npm run web:demo` do not need them (they use an offline placeholder project).
# CI builds read the same names from the GitHub repository variables.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In iOS Client ID (Phase 3 — Mode B Native .ipa)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Local Encrypted Storage Pepper (ADR 0016, ADR 0027 §2.6). NOT a secret: every EXPO_PUBLIC_* value is
# inlined into the bundle. The real protection is the device token in Keychain/Keystore (sessionStorage
# on Web). Leave EMPTY: every build so far uses the built-in default, and a new value only forces the
# fallback path that re-encrypts old data.
EXPO_PUBLIC_LOCAL_CIPHER_PEPPER=

# Firebase App Check (ADR 0038). Both optional; leave EMPTY until the console steps are done.
# Web: reCAPTCHA Enterprise site key (public). Register it in Firebase Console → App Check first.
EXPO_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=
# iOS/Android: "1" turns on the native hook. No native attestation module exists yet, so it stays
# "unavailable". Do NOT enforce App Check in the console while native clients send no token.
EXPO_PUBLIC_FIREBASE_APPCHECK_NATIVE=

# Local showcase mode (ADR 0010). Leave EMPTY in real builds.
# "1" boots signed in as the local demo user with the example budget, never talks to
# Firebase and accepts ?skin=ios|android|web and ?theme=dark|light in the URL.
# `npm run web:demo` sets it for you; you normally do not need to write it here.
EXPO_PUBLIC_BFLOW_DEMO=
