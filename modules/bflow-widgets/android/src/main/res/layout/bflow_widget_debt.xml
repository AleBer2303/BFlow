<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Deudas" (3x2): deuda restante, avance desde el primer mes, abono y cierre estimado. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bflow_widget_background"
  android:clipToOutline="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/bflow_widget_padding"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/bflow_widget_padding"
    android:paddingBottom="@dimen/bflow_widget_padding">

    <include layout="@layout/bflow_widget_header" />

    <LinearLayout
      android:id="@+id/bflow_widget_content"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <LinearLayout
        android:id="@+id/debt_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:text="@string/bflow_widget_debt_remaining"
          android:textColor="@color/bflow_widget_text_muted"
          android:textSize="12sp" />
        <TextView
          android:id="@+id/debt_amount"
          android:layout_width="match_parent"
          android:layout_height="32dp"
          android:autoSizeMaxTextSize="24sp"
          android:autoSizeMinTextSize="12sp"
          android:autoSizeStepGranularity="1sp"
          android:autoSizeTextType="uniform"
          android:fontFamily="sans-serif-medium"
          android:fontFeatureSettings="tnum"
          android:gravity="center_vertical|start"
          android:maxLines="1"
          android:text="@string/bflow_widget_placeholder"
          android:textColor="@color/bflow_widget_debt"
          android:textSize="24sp" />
        <ProgressBar
          android:id="@+id/debt_progress"
          style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="match_parent"
          android:layout_height="6dp"
          android:layout_marginTop="4dp"
          android:indeterminate="false"
          android:max="100"
          android:maxHeight="6dp"
          android:minHeight="6dp"
          android:progress="0"
          android:progressDrawable="@drawable/bflow_widget_progress_debt" />
        <TextView
          android:id="@+id/debt_progress_label"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_secondary"
          android:textSize="12sp"
          android:layout_marginTop="4dp"
          android:fontFeatureSettings="tnum" />
        <TextView
          android:id="@+id/debt_paid_month"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_muted"
          android:textSize="12sp"
          android:fontFeatureSettings="tnum" />
        <TextView
          android:id="@+id/debt_payoff"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_muted"
          android:textSize="12sp"
          android:visibility="gone" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/debt_none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:text="@string/bflow_widget_debt_none"
          android:textColor="@color/bflow_widget_completed"
          android:textSize="20sp"
          android:fontFamily="sans-serif-medium" />
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:text="@string/bflow_widget_debt_none_detail"
          android:textColor="@color/bflow_widget_text_muted"
          android:textSize="12sp" />
      </LinearLayout>
    </LinearLayout>

    <include layout="@layout/bflow_widget_empty" />
  </LinearLayout>

  <include layout="@layout/bflow_widget_refresh_button" />
</FrameLayout>
