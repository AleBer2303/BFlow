<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Flujo neto" (2x2): flujo neto con signo, mes y checklist. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bflow_widget_background"
  android:clipToOutline="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/bflow_widget_padding"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/bflow_widget_padding"
    android:paddingBottom="@dimen/bflow_widget_padding">

    <include layout="@layout/bflow_widget_header" />

    <LinearLayout
      android:id="@+id/bflow_widget_content"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <TextView
        android:id="@+id/netflow_amount"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="28sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:text="@string/bflow_widget_placeholder"
        android:textColor="@color/bflow_widget_income"
        android:textSize="28sp" />
      <TextView
        android:id="@+id/netflow_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_secondary"
        android:textSize="13sp" />
      <TextView
        android:id="@+id/netflow_checklist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_muted"
        android:textSize="12sp"
        android:fontFeatureSettings="tnum" />
    </LinearLayout>

    <include layout="@layout/bflow_widget_empty" />
  </LinearLayout>

  <include layout="@layout/bflow_widget_refresh_button" />
</FrameLayout>
