<?xml version="1.0" encoding="utf-8"?>
<!-- NetFlowSmallView (iOS systemSmall) = 2x2. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bflow_widget_background"
  android:clipToOutline="true">

  <LinearLayout
    android:id="@+id/bflow_widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/bflow_widget_padding">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:minHeight="20dp">
      <TextView
        android:id="@+id/bflow_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />
      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:minWidth="4dp" />
      <TextView
        android:id="@+id/bflow_widget_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_secondary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:minHeight="6dp" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/netflow_icon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/bflow_widget_ic_arrow_up_right_income" />
      <TextView
        android:id="@+id/netflow_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_secondary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <TextView
      android:id="@+id/netflow_amount"
      android:layout_width="match_parent"
      android:layout_height="30dp"
      android:autoSizeMaxTextSize="22sp"
      android:autoSizeMinTextSize="12sp"
      android:autoSizeStepGranularity="1sp"
      android:autoSizeTextType="uniform"
      android:gravity="center_vertical|start"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:textColor="@color/bflow_widget_income"
      android:textSize="22sp"
      android:textStyle="bold" />
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:minHeight="6dp" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/bflow_widget_ic_checklist_completed" />
      <TextView
        android:id="@+id/netflow_checklist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_primary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <ProgressBar
      android:id="@+id/netflow_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="4dp"
      android:layout_marginTop="4dp"
      android:importantForAccessibility="no"
      android:indeterminate="false"
      android:max="1000"
      android:maxHeight="4dp"
      android:minHeight="4dp"
      android:progress="0"
      android:progressDrawable="@drawable/bflow_widget_progress_completed" />
    <TextView
      android:id="@+id/bflow_widget_updated"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:textColor="@color/bflow_widget_text_secondary"
      android:textSize="11sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/bflow_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/bflow_widget_padding"
    android:visibility="gone"
    android:contentDescription="@string/bflow_widget_empty">
    <ImageView
      android:layout_width="22dp"
      android:layout_height="22dp"
      android:importantForAccessibility="no"
      android:scaleType="fitCenter"
      android:src="@drawable/bflow_widget_ic_chart_trend_accent" />
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:minHeight="8dp" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="@string/bflow_widget_brand"
      android:textColor="@color/bflow_widget_text_primary"
      android:textSize="17sp"
      android:fontFamily="sans-serif-medium" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="3"
      android:text="@string/bflow_widget_empty"
      android:textColor="@color/bflow_widget_text_secondary"
      android:textSize="15sp" />
  </LinearLayout>

</FrameLayout>
