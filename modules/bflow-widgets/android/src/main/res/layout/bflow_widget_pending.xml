<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Pendientes" (4x4, redimensionable): totales, avance y hasta 8 filas fijas. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bflow_widget_background"
  android:clipToOutline="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/bflow_widget_padding"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/bflow_widget_padding"
    android:paddingBottom="@dimen/bflow_widget_padding">

    <include layout="@layout/bflow_widget_header" />

    <LinearLayout
      android:id="@+id/bflow_widget_content"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingEnd="8dp">
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/bflow_widget_to_pay"
            android:textColor="@color/bflow_widget_text_muted"
            android:textSize="12sp" />
          <TextView
            android:id="@+id/pending_total_expense"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/bflow_widget_placeholder"
            android:textColor="@color/bflow_widget_expense"
            android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingEnd="8dp">
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/bflow_widget_to_receive"
            android:textColor="@color/bflow_widget_text_muted"
            android:textSize="12sp" />
          <TextView
            android:id="@+id/pending_total_income"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/bflow_widget_placeholder"
            android:textColor="@color/bflow_widget_income"
            android:textSize="16sp" />
        </LinearLayout>
      </LinearLayout>
      <ProgressBar
        android:id="@+id/pending_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:indeterminate="false"
        android:max="100"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:progress="0"
        android:progressDrawable="@drawable/bflow_widget_progress_completed" />
      <TextView
        android:id="@+id/pending_progress_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_muted"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:fontFeatureSettings="tnum" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">
        <LinearLayout
          android:id="@+id/pending_row_1"
          android:layout_width="match_parent"
          android:layout_height="@dimen/bflow_widget_pending_row_height"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:visibility="gone">
          <ImageView
            android:id="@+id/pending_dot_1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bflow_widget_dot_expense" />
          <TextView
            android:id="@+id/pending_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
          <TextView
            android:id="@+id/pending_amount_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/bflow_widget_placeholder"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
          android:id="@+id/pending_row_2"
          android:layout_width="match_parent"
          android:layout_height="@dimen/bflow_widget_pending_row_height"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:visibility="gone">
          <ImageView
            android:id="@+id/pending_dot_2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bflow_widget_dot_expense" />
          <TextView
            android:id="@+id/pending_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
          <TextView
            android:id="@+id/pending_amount_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/bflow_widget_placeholder"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
          android:id="@+id/pending_row_3"
          android:layout_width="match_parent"
          android:layout_height="@dimen/bflow_widget_pending_row_height"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:visibility="gone">
          <ImageView
            android:id="@+id/pending_dot_3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bflow_widget_dot_expense" />
          <TextView
            android:id="@+id/pending_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
          <TextView
            android:id="@+id/pending_amount_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/bflow_widget_placeholder"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
          android:id="@+id/pending_row_4"
          android:layout_width="match_parent"
          android:layout_height="@dimen/bflow_widget_pending_row_height"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:visibility="gone">
          <ImageView
            android:id="@+id/pending_dot_4"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bflow_widget_dot_expense" />
          <TextView
            android:id="@+id/pending_name_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
          <TextView
            android:id="@+id/pending_amount_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/bflow_widget_placeholder"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
          android:id="@+id/pending_row_5"
          android:layout_width="match_parent"
          android:layout_height="@dimen/bflow_widget_pending_row_height"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:visibility="gone">
          <ImageView
            android:id="@+id/pending_dot_5"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bflow_widget_dot_expense" />
          <TextView
            android:id="@+id/pending_name_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
          <TextView
            android:id="@+id/pending_amount_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/bflow_widget_placeholder"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
          android:id="@+id/pending_row_6"
          android:layout_width="match_parent"
          android:layout_height="@dimen/bflow_widget_pending_row_height"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:visibility="gone">
          <ImageView
            android:id="@+id/pending_dot_6"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bflow_widget_dot_expense" />
          <TextView
            android:id="@+id/pending_name_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
          <TextView
            android:id="@+id/pending_amount_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/bflow_widget_placeholder"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
          android:id="@+id/pending_row_7"
          android:layout_width="match_parent"
          android:layout_height="@dimen/bflow_widget_pending_row_height"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:visibility="gone">
          <ImageView
            android:id="@+id/pending_dot_7"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bflow_widget_dot_expense" />
          <TextView
            android:id="@+id/pending_name_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
          <TextView
            android:id="@+id/pending_amount_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/bflow_widget_placeholder"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
          android:id="@+id/pending_row_8"
          android:layout_width="match_parent"
          android:layout_height="@dimen/bflow_widget_pending_row_height"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:visibility="gone">
          <ImageView
            android:id="@+id/pending_dot_8"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bflow_widget_dot_expense" />
          <TextView
            android:id="@+id/pending_name_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
          <TextView
            android:id="@+id/pending_amount_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/bflow_widget_placeholder"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="13sp" />
        </LinearLayout>
      </LinearLayout>
      <TextView
        android:id="@+id/pending_none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/bflow_widget_pending_none"
        android:textColor="@color/bflow_widget_completed"
        android:textSize="13sp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />
      <TextView
        android:id="@+id/pending_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_muted"
        android:textSize="12sp"
        android:visibility="gone" />
    </LinearLayout>

    <include layout="@layout/bflow_widget_empty" />
  </LinearLayout>

  <include layout="@layout/bflow_widget_refresh_button" />
</FrameLayout>
