<?xml version="1.0" encoding="utf-8"?>
<!-- PendingLargeView (iOS systemLarge) = 4x4. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bflow_widget_background"
  android:clipToOutline="true">

  <LinearLayout
    android:id="@+id/bflow_widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/bflow_widget_padding">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:minHeight="20dp">
      <TextView
        android:id="@+id/bflow_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />
      <TextView
        android:id="@+id/bflow_widget_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_secondary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium" />
      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:minWidth="4dp" />
      <TextView
        android:id="@+id/bflow_widget_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_secondary"
        android:textSize="11sp" />
      <!-- Hueco del icono "Actualizar" (24 dp como en iOS); el boton tactil de 48 dp va encima. -->
      <FrameLayout
        android:layout_width="24dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/pending_checklist_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:layout_marginTop="10dp">
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/bflow_widget_checklist"
        android:textColor="@color/bflow_widget_text_secondary"
        android:textSize="12sp" />
      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:minWidth="4dp" />
      <TextView
        android:id="@+id/pending_checklist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <ProgressBar
      android:id="@+id/pending_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="6dp"
      android:layout_marginTop="5dp"
      android:importantForAccessibility="no"
      android:indeterminate="false"
      android:max="1000"
      android:maxHeight="6dp"
      android:minHeight="6dp"
      android:progress="0"
      android:progressDrawable="@drawable/bflow_widget_progress_completed" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="top"
      android:orientation="horizontal"
      android:layout_marginTop="10dp">
      <LinearLayout
        android:id="@+id/pending_expense"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">
          <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/bflow_widget_ic_arrow_up_right_expense" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/bflow_widget_to_pay"
            android:textColor="@color/bflow_widget_text_secondary"
            android:textSize="12sp" />
        </LinearLayout>
        <TextView
          android:id="@+id/pending_expense_amount"
          android:layout_width="match_parent"
          android:layout_height="24dp"
          android:layout_marginTop="2dp"
          android:autoSizeMaxTextSize="17sp"
          android:autoSizeMinTextSize="10sp"
          android:autoSizeStepGranularity="1sp"
          android:autoSizeTextType="uniform"
          android:gravity="center_vertical|start"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFeatureSettings="tnum"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_expense"
          android:textSize="17sp"
          android:textStyle="bold" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/pending_income"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">
          <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/bflow_widget_ic_arrow_down_left_income" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/bflow_widget_to_receive"
            android:textColor="@color/bflow_widget_text_secondary"
            android:textSize="12sp" />
        </LinearLayout>
        <TextView
          android:id="@+id/pending_income_amount"
          android:layout_width="match_parent"
          android:layout_height="24dp"
          android:layout_marginTop="2dp"
          android:autoSizeMaxTextSize="17sp"
          android:autoSizeMinTextSize="10sp"
          android:autoSizeStepGranularity="1sp"
          android:autoSizeTextType="uniform"
          android:gravity="center_vertical|start"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFeatureSettings="tnum"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_income"
          android:textSize="17sp"
          android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout
      android:id="@+id/pending_list"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:layout_marginTop="10dp">
      <LinearLayout
        android:id="@+id/pending_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView
          android:id="@+id/pending_icon_1"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:importantForAccessibility="no"
          android:scaleType="fitCenter"
          android:src="@drawable/bflow_widget_ic_circle_up_right_expense" />
        <TextView
          android:id="@+id/pending_name_1"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="8dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_primary"
          android:textSize="15sp" />
        <TextView
          android:id="@+id/pending_amount_1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFeatureSettings="tnum"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_primary"
          android:textSize="15sp"
          android:fontFamily="sans-serif-medium" />
      </LinearLayout>
      <FrameLayout
        android:id="@+id/pending_divider_2"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/bflow_widget_track"
        android:visibility="gone" />
      <LinearLayout
        android:id="@+id/pending_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView
          android:id="@+id/pending_icon_2"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:importantForAccessibility="no"
          android:scaleType="fitCenter"
          android:src="@drawable/bflow_widget_ic_circle_up_right_expense" />
        <TextView
          android:id="@+id/pending_name_2"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="8dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_primary"
          android:textSize="15sp" />
        <TextView
          android:id="@+id/pending_amount_2"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFeatureSettings="tnum"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_primary"
          android:textSize="15sp"
          android:fontFamily="sans-serif-medium" />
      </LinearLayout>
      <FrameLayout
        android:id="@+id/pending_divider_3"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/bflow_widget_track"
        android:visibility="gone" />
      <LinearLayout
        android:id="@+id/pending_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView
          android:id="@+id/pending_icon_3"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:importantForAccessibility="no"
          android:scaleType="fitCenter"
          android:src="@drawable/bflow_widget_ic_circle_up_right_expense" />
        <TextView
          android:id="@+id/pending_name_3"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="8dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_primary"
          android:textSize="15sp" />
        <TextView
          android:id="@+id/pending_amount_3"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFeatureSettings="tnum"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_primary"
          android:textSize="15sp"
          android:fontFamily="sans-serif-medium" />
      </LinearLayout>
      <FrameLayout
        android:id="@+id/pending_divider_4"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/bflow_widget_track"
        android:visibility="gone" />
      <LinearLayout
        android:id="@+id/pending_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView
          android:id="@+id/pending_icon_4"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:importantForAccessibility="no"
          android:scaleType="fitCenter"
          android:src="@drawable/bflow_widget_ic_circle_up_right_expense" />
        <TextView
          android:id="@+id/pending_name_4"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="8dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_primary"
          android:textSize="15sp" />
        <TextView
          android:id="@+id/pending_amount_4"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFeatureSettings="tnum"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_primary"
          android:textSize="15sp"
          android:fontFamily="sans-serif-medium" />
      </LinearLayout>
      <FrameLayout
        android:id="@+id/pending_divider_5"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/bflow_widget_track"
        android:visibility="gone" />
      <LinearLayout
        android:id="@+id/pending_row_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView
          android:id="@+id/pending_icon_5"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:importantForAccessibility="no"
          android:scaleType="fitCenter"
          android:src="@drawable/bflow_widget_ic_circle_up_right_expense" />
        <TextView
          android:id="@+id/pending_name_5"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="8dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_primary"
          android:textSize="15sp" />
        <TextView
          android:id="@+id/pending_amount_5"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFeatureSettings="tnum"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_primary"
          android:textSize="15sp"
          android:fontFamily="sans-serif-medium" />
      </LinearLayout>
      <FrameLayout
        android:id="@+id/pending_divider_6"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/bflow_widget_track"
        android:visibility="gone" />
      <LinearLayout
        android:id="@+id/pending_row_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">
        <ImageView
          android:id="@+id/pending_icon_6"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:importantForAccessibility="no"
          android:scaleType="fitCenter"
          android:src="@drawable/bflow_widget_ic_circle_up_right_expense" />
        <TextView
          android:id="@+id/pending_name_6"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="8dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_primary"
          android:textSize="15sp" />
        <TextView
          android:id="@+id/pending_amount_6"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="6dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFeatureSettings="tnum"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_text_primary"
          android:textSize="15sp"
          android:fontFamily="sans-serif-medium" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout
      android:id="@+id/pending_none"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="horizontal"
      android:visibility="gone">
      <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/bflow_widget_ic_seal_completed" />
      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="8dp">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="@string/bflow_widget_all_done"
          android:textColor="@color/bflow_widget_text_primary"
          android:textSize="15sp"
          android:fontFamily="sans-serif-medium" />
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="@string/bflow_widget_all_done_detail"
          android:textColor="@color/bflow_widget_text_secondary"
          android:textSize="12sp" />
      </LinearLayout>
    </LinearLayout>
    <FrameLayout
      android:id="@+id/pending_spacer"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:minHeight="0dp" />
    <TextView
      android:id="@+id/pending_more"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:visibility="gone"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textColor="@color/bflow_widget_text_secondary"
      android:textSize="11sp" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/bflow_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/bflow_widget_padding"
    android:visibility="gone"
    android:contentDescription="@string/bflow_widget_empty">
    <ImageView
      android:layout_width="22dp"
      android:layout_height="22dp"
      android:importantForAccessibility="no"
      android:scaleType="fitCenter"
      android:src="@drawable/bflow_widget_ic_chart_trend_accent" />
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:minHeight="8dp" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="@string/bflow_widget_brand"
      android:textColor="@color/bflow_widget_text_primary"
      android:textSize="17sp"
      android:fontFamily="sans-serif-medium" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="3"
      android:text="@string/bflow_widget_empty"
      android:textColor="@color/bflow_widget_text_secondary"
      android:textSize="15sp" />
  </LinearLayout>

  <!-- Boton "Actualizar": icono de 12 dp (caption2) alineado con la cabecera; objetivo de 48 dp. -->
  <ImageView
    android:id="@+id/bflow_widget_refresh"
    android:layout_width="@dimen/bflow_widget_touch_target"
    android:layout_height="@dimen/bflow_widget_touch_target"
    android:layout_gravity="top|end"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="4dp"
    android:background="@drawable/bflow_widget_refresh_ripple"
    android:contentDescription="@string/bflow_widget_refresh"
    android:padding="18dp"
    android:scaleType="fitCenter"
    android:src="@drawable/bflow_widget_ic_refresh_text_secondary"
    android:visibility="gone" />
</FrameLayout>
