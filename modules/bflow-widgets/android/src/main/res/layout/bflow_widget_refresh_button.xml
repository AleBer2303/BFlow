<?xml version="1.0" encoding="utf-8"?>
<!-- Boton "Actualizar": icono de 20 dp dentro de un objetivo tactil de 48 dp (AGENTS.md §7.3). -->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/bflow_widget_refresh"
  android:layout_width="@dimen/bflow_widget_touch_target"
  android:layout_height="@dimen/bflow_widget_touch_target"
  android:layout_gravity="top|end"
  android:background="@drawable/bflow_widget_refresh_ripple"
  android:contentDescription="@string/bflow_widget_refresh"
  android:padding="14dp"
  android:scaleType="fitCenter"
  android:src="@drawable/bflow_widget_ic_refresh"
  android:visibility="gone" />
