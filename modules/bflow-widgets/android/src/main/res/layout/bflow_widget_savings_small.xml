<?xml version="1.0" encoding="utf-8"?>
<!-- SavingsSmallView (iOS systemSmall) = 2x2. Sin "Act." (en iOS no cabe con tres bolsillos). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bflow_widget_background"
  android:clipToOutline="true">

  <LinearLayout
    android:id="@+id/bflow_widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/bflow_widget_padding">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:minHeight="20dp">
      <TextView
        android:id="@+id/bflow_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />
      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:minWidth="4dp" />
      <TextView
        android:id="@+id/bflow_widget_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_secondary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:minHeight="6dp" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="@string/bflow_widget_savings_total_short"
      android:textColor="@color/bflow_widget_text_secondary"
      android:textSize="11sp" />
    <TextView
      android:id="@+id/savings_total"
      android:layout_width="match_parent"
      android:layout_height="28dp"
      android:autoSizeMaxTextSize="20sp"
      android:autoSizeMinTextSize="11sp"
      android:autoSizeStepGranularity="1sp"
      android:autoSizeTextType="uniform"
      android:gravity="center_vertical|start"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:fontFeatureSettings="tnum"
      android:maxLines="1"
      android:textColor="@color/bflow_widget_savings"
      android:textSize="20sp"
      android:textStyle="bold" />
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:minHeight="6dp" />
    <LinearLayout
      android:id="@+id/savings_reserve_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/savings_reserve_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/bflow_widget_dot_reserve" />
      <TextView
        android:id="@+id/savings_reserve_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_secondary"
        android:textSize="12sp" />
      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:minWidth="4dp" />
      <TextView
        android:id="@+id/savings_reserve_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/savings_savings_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:layout_marginTop="3dp">
      <ImageView
        android:id="@+id/savings_savings_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/bflow_widget_dot_savings" />
      <TextView
        android:id="@+id/savings_savings_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_secondary"
        android:textSize="12sp" />
      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:minWidth="4dp" />
      <TextView
        android:id="@+id/savings_savings_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <LinearLayout
      android:id="@+id/savings_other_row"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:layout_marginTop="3dp"
      android:visibility="gone">
      <ImageView
        android:id="@+id/savings_other_dot"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/bflow_widget_dot_accent" />
      <TextView
        android:id="@+id/savings_other_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_secondary"
        android:textSize="12sp" />
      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:minWidth="4dp" />
      <TextView
        android:id="@+id/savings_other_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/bflow_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/bflow_widget_padding"
    android:visibility="gone"
    android:contentDescription="@string/bflow_widget_empty">
    <ImageView
      android:layout_width="22dp"
      android:layout_height="22dp"
      android:importantForAccessibility="no"
      android:scaleType="fitCenter"
      android:src="@drawable/bflow_widget_ic_chart_trend_accent" />
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:minHeight="8dp" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="@string/bflow_widget_brand"
      android:textColor="@color/bflow_widget_text_primary"
      android:textSize="17sp"
      android:fontFamily="sans-serif-medium" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="3"
      android:text="@string/bflow_widget_empty"
      android:textColor="@color/bflow_widget_text_secondary"
      android:textSize="15sp" />
  </LinearLayout>

</FrameLayout>
