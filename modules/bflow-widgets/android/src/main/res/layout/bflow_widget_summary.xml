<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Resumen" (4x2): recibido / pagado / por pagar y barras de la tendencia. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bflow_widget_background"
  android:clipToOutline="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/bflow_widget_padding"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/bflow_widget_padding"
    android:paddingBottom="@dimen/bflow_widget_padding">

    <include layout="@layout/bflow_widget_header" />

    <LinearLayout
      android:id="@+id/bflow_widget_content"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="vertical">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingEnd="8dp">
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/bflow_widget_received"
            android:textColor="@color/bflow_widget_text_muted"
            android:textSize="12sp" />
          <TextView
            android:id="@+id/summary_received"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/bflow_widget_placeholder"
            android:textColor="@color/bflow_widget_income"
            android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingEnd="8dp">
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/bflow_widget_paid"
            android:textColor="@color/bflow_widget_text_muted"
            android:textSize="12sp" />
          <TextView
            android:id="@+id/summary_paid"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/bflow_widget_placeholder"
            android:textColor="@color/bflow_widget_expense"
            android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingEnd="8dp">
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/bflow_widget_to_pay"
            android:textColor="@color/bflow_widget_text_muted"
            android:textSize="12sp" />
          <TextView
            android:id="@+id/summary_pending"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:text="@string/bflow_widget_placeholder"
            android:textColor="@color/bflow_widget_pending"
            android:textSize="16sp" />
        </LinearLayout>
      </LinearLayout>
      <ImageView
        android:id="@+id/summary_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:scaleType="fitCenter" />
    </LinearLayout>

    <include layout="@layout/bflow_widget_empty" />
  </LinearLayout>

  <include layout="@layout/bflow_widget_refresh_button" />
</FrameLayout>
