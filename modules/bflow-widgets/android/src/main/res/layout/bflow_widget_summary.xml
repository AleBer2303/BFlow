<?xml version="1.0" encoding="utf-8"?>
<!-- SummaryMediumView (iOS systemMedium) = 4x2. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/bflow_widget_background"
  android:clipToOutline="true">

  <LinearLayout
    android:id="@+id/bflow_widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/bflow_widget_padding">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:minHeight="20dp">
      <TextView
        android:id="@+id/bflow_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_primary"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium" />
      <TextView
        android:id="@+id/bflow_widget_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_secondary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium" />
      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:minWidth="4dp" />
      <TextView
        android:id="@+id/bflow_widget_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:fontFeatureSettings="tnum"
        android:maxLines="1"
        android:textColor="@color/bflow_widget_text_secondary"
        android:textSize="11sp" />
      <!-- Hueco del icono "Actualizar" (24 dp como en iOS); el boton tactil de 48 dp va encima. -->
      <FrameLayout
        android:layout_width="24dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:gravity="top"
      android:orientation="horizontal"
      android:layout_weight="1"
      android:layout_marginTop="4dp">
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:maxLines="1"
          android:text="@string/bflow_widget_netflow_title"
          android:textColor="@color/bflow_widget_text_secondary"
          android:textSize="11sp" />
        <TextView
          android:id="@+id/summary_net"
          android:layout_width="match_parent"
          android:layout_height="24dp"
          android:autoSizeMaxTextSize="17sp"
          android:autoSizeMinTextSize="10sp"
          android:autoSizeStepGranularity="1sp"
          android:autoSizeTextType="uniform"
          android:gravity="center_vertical|start"
          android:ellipsize="end"
          android:includeFontPadding="false"
          android:fontFeatureSettings="tnum"
          android:maxLines="1"
          android:textColor="@color/bflow_widget_income"
          android:textSize="17sp"
          android:textStyle="bold" />
        <LinearLayout
          android:id="@+id/summary_received_row"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:layout_marginTop="3dp">
          <ImageView
            android:id="@+id/summary_received_icon"
            android:layout_width="14dp"
            android:layout_height="11dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/bflow_widget_ic_arrow_down_left_income" />
          <TextView
            android:id="@+id/summary_received_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/bflow_widget_received"
            android:textColor="@color/bflow_widget_text_secondary"
            android:textSize="12sp" />
          <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:minWidth="4dp" />
          <TextView
            android:id="@+id/summary_received_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <LinearLayout
          android:id="@+id/summary_paid_row"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:layout_marginTop="3dp">
          <ImageView
            android:id="@+id/summary_paid_icon"
            android:layout_width="14dp"
            android:layout_height="11dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/bflow_widget_ic_arrow_up_right_expense" />
          <TextView
            android:id="@+id/summary_paid_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/bflow_widget_paid"
            android:textColor="@color/bflow_widget_text_secondary"
            android:textSize="12sp" />
          <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:minWidth="4dp" />
          <TextView
            android:id="@+id/summary_paid_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <LinearLayout
          android:id="@+id/summary_pending_row"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:layout_marginTop="3dp">
          <ImageView
            android:id="@+id/summary_pending_icon"
            android:layout_width="14dp"
            android:layout_height="11dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/bflow_widget_ic_clock_pending" />
          <TextView
            android:id="@+id/summary_pending_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/bflow_widget_to_pay"
            android:textColor="@color/bflow_widget_text_secondary"
            android:textSize="12sp" />
          <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:minWidth="4dp" />
          <TextView
            android:id="@+id/summary_pending_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="@color/bflow_widget_text_primary"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
        </LinearLayout>
      </LinearLayout>
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">
        <ImageView
          android:id="@+id/summary_chart"
          android:layout_width="match_parent"
          android:layout_height="0dp"
          android:layout_weight="1"
          android:scaleType="fitCenter" />
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:orientation="horizontal"
          android:layout_marginTop="4dp"
          android:importantForAccessibility="noHideDescendants">
          <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/bflow_widget_dot_income" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/bflow_widget_chart_legend_income"
            android:textColor="@color/bflow_widget_text_secondary"
            android:textSize="9sp"
            android:fontFamily="sans-serif-medium" />
          <ImageView
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/bflow_widget_dot_expense" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/bflow_widget_chart_legend_expense"
            android:textColor="@color/bflow_widget_text_secondary"
            android:textSize="9sp"
            android:fontFamily="sans-serif-medium" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/bflow_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/bflow_widget_padding"
    android:visibility="gone"
    android:contentDescription="@string/bflow_widget_empty">
    <ImageView
      android:layout_width="22dp"
      android:layout_height="22dp"
      android:importantForAccessibility="no"
      android:scaleType="fitCenter"
      android:src="@drawable/bflow_widget_ic_chart_trend_accent" />
    <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:minHeight="8dp" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="@string/bflow_widget_brand"
      android:textColor="@color/bflow_widget_text_primary"
      android:textSize="17sp"
      android:fontFamily="sans-serif-medium" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:ellipsize="end"
      android:includeFontPadding="false"
      android:maxLines="3"
      android:text="@string/bflow_widget_empty"
      android:textColor="@color/bflow_widget_text_secondary"
      android:textSize="15sp" />
  </LinearLayout>

  <!-- Boton "Actualizar": icono de 12 dp (caption2) alineado con la cabecera; objetivo de 48 dp. -->
  <ImageView
    android:id="@+id/bflow_widget_refresh"
    android:layout_width="@dimen/bflow_widget_touch_target"
    android:layout_height="@dimen/bflow_widget_touch_target"
    android:layout_gravity="top|end"
    android:layout_marginTop="2dp"
    android:layout_marginEnd="4dp"
    android:background="@drawable/bflow_widget_refresh_ripple"
    android:contentDescription="@string/bflow_widget_refresh"
    android:padding="18dp"
    android:scaleType="fitCenter"
    android:src="@drawable/bflow_widget_ic_refresh_text_secondary"
    android:visibility="gone" />
</FrameLayout>
