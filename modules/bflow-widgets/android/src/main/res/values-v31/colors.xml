<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ en claro: fondo, superficies, texto y acento siguen el color dinamico del sistema
  (Material You). Los semanticos (ingreso, gasto, pendiente, deuda, ahorro) NO cambian: se
  heredan de values/colors.xml para que el verde y el rojo signifiquen lo mismo que en la app.
  Las paletas neutras son casi grises, asi que el contraste AA de los semanticos se mantiene.
-->
<resources>
  <color name="bflow_widget_background">@android:color/system_neutral1_10</color>
  <color name="bflow_widget_surface">@android:color/system_neutral2_50</color>
  <color name="bflow_widget_surface_elevated">@android:color/system_neutral2_100</color>
  <color name="bflow_widget_outline">@android:color/system_neutral2_300</color>

  <color name="bflow_widget_text_primary">@android:color/system_neutral1_900</color>
  <color name="bflow_widget_text_secondary">@android:color/system_neutral2_700</color>
  <color name="bflow_widget_text_muted">@android:color/system_neutral2_600</color>

  <color name="bflow_widget_accent">@android:color/system_accent1_600</color>
  <color name="bflow_widget_track">@android:color/system_accent1_100</color>
</resources>
