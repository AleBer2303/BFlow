{
  "name": "bflow",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/patch-extension-storage.mjs",
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "web:demo": "node scripts/start-demo.mjs",
    "web:export": "npx expo export --platform web --clear",
    "web:deploy": "npm run web:export && npx firebase-tools deploy --only hosting --project bflow-deaeb",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-check.mjs",
    "test": "jest --watchAll=false",
    "test:domain": "jest src/domain",
    "test:changed": "jest --onlyChanged",
    "test:phase0": "node --test scripts/verify-phase0-fixture.test.mjs",
    "test:scripts": "node --test scripts/release.test.mjs scripts/workflow-guards.test.mjs scripts/worklet-closure-guard.test.mjs scripts/compress-icons.test.mjs",
    "release": "node scripts/release.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "compress:icons": "node scripts/compress-icons.mjs"
  },
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-gl": "~58.0.4",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "firebase": "^11.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "three": "0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "@types/three": "0.187.0",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.15",
    "react-test-renderer": "19.3.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "@bacons/xcode": {
      "@expo/plist": {
        "@xmldom/xmldom": "^0.8.15"
      },
      "uuid": "^11.1.1"
    },
    "@expo/fingerprint": {
      "minimatch": "^11.0.5"
    },
    "@bacons/apple-targets": {
      "glob": "^14.0.6"
    }
  }
}
